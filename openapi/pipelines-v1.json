{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PublicProblem"
            }
          }
        },
        "description": "An error occurred (RFC 9457 problem+json). Switch on the stable `code`, not on prose."
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PublicProblem"
            }
          }
        },
        "description": "The addressed resource does not exist, or is not visible to your tenant."
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PublicProblem"
            }
          }
        },
        "description": "API key missing or invalid."
      },
      "ValidationProblem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PublicProblem"
            }
          }
        },
        "description": "The request was malformed or failed validation; see `errors` for the offending fields."
      }
    },
    "schemas": {
      "NodeRunStatus": {
        "enum": [
          "waiting",
          "queued",
          "running",
          "finished",
          "failed",
          "skipped",
          "stopped",
          "cancelled"
        ],
        "title": "NodeRunStatus",
        "type": "string"
      },
      "PublicNodeRun": {
        "properties": {
          "completedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "jobsComplete": {
            "title": "Jobscomplete",
            "type": "integer"
          },
          "jobsTotal": {
            "title": "Jobstotal",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "nodeId": {
            "description": "The stable pipeline node id.",
            "title": "Nodeid",
            "type": "string"
          },
          "nodeType": {
            "title": "Nodetype",
            "type": "string"
          },
          "outputCount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outputcount"
          },
          "outputGroup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The molecules group id this node run produced.",
            "title": "Outputgroup"
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "status": {
            "$ref": "#/components/schemas/NodeRunStatus"
          }
        },
        "required": [
          "id",
          "nodeId",
          "label",
          "nodeType",
          "status",
          "startedAt",
          "completedAt",
          "outputCount",
          "jobsTotal",
          "jobsComplete",
          "outputGroup"
        ],
        "title": "PublicNodeRun",
        "type": "object"
      },
      "PublicNodeRunMolecule": {
        "description": "One molecule a node run produced.\n\nRead from the node run's passing outputs directly, NOT from `PublicNodeRun.outputGroup` \u2014 which\nis why this exists. A node run's `outputGroup` is the group the node minted, and a node that enriches its\ninputs in place (scoring, structure prediction) mints none: its molecules never moved, so they\nstay in the group they came from and `outputGroup` is correctly null. A filter node has no group\neither \u2014 its survivors exist only as outputs. Reading results by group therefore reports\n\"produced nothing\" for exactly the node runs that produced the most interesting thing.",
        "properties": {
          "hasStructure": {
            "title": "Hasstructure",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scores": {
            "additionalProperties": true,
            "description": "Per-tool scores keyed by tool.",
            "title": "Scores",
            "type": "object"
          },
          "sequence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ':'-joined chain sequences.",
            "title": "Sequence"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "sequence",
          "scores",
          "hasStructure"
        ],
        "title": "PublicNodeRunMolecule",
        "type": "object"
      },
      "PublicNodeRunMoleculePage": {
        "properties": {
          "molecules": {
            "items": {
              "$ref": "#/components/schemas/PublicNodeRunMolecule"
            },
            "title": "Molecules",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` for the next page.",
            "title": "Nextcursor"
          }
        },
        "required": [
          "molecules",
          "nextCursor"
        ],
        "title": "PublicNodeRunMoleculePage",
        "type": "object"
      },
      "PublicProblem": {
        "additionalProperties": false,
        "description": "RFC 9457 problem detail. Serialized as `application/problem+json` on every public error.",
        "properties": {
          "code": {
            "description": "A stable machine-readable slug; switch on THIS, not prose.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Instance-specific human explanation.",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Structured per-item detail (request-validation fields OR pipeline diagnostics).",
            "title": "Errors"
          },
          "status": {
            "description": "The HTTP status code, duplicated in the body per RFC 9457.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the error kind.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "A URI identifying the error kind (dereferenceable docs).",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "PublicProblem",
        "type": "object"
      },
      "PublicRun": {
        "properties": {
          "completedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": true,
            "description": "The recorded inputs (input-node id -> {group} or {file}).",
            "title": "Inputs",
            "type": "object"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "nodeRuns": {
            "items": {
              "$ref": "#/components/schemas/PublicNodeRun"
            },
            "title": "Noderuns",
            "type": "array"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "startedAt": {
            "title": "Startedat",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "templateId": {
            "title": "Templateid",
            "type": "string"
          },
          "templateVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The executed version handle e.g. 'v1'.",
            "title": "Templateversion"
          }
        },
        "required": [
          "id",
          "templateId",
          "templateVersion",
          "name",
          "source",
          "status",
          "startedAt",
          "completedAt",
          "inputs",
          "nodeRuns"
        ],
        "title": "PublicRun",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "running",
          "finished",
          "partial",
          "stopped",
          "failed"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "Source": {
        "enum": [
          "production",
          "test"
        ],
        "title": "Source",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Use the Tamarind API to manage molecules, run pipelines, and build custom tools. Authenticate with an API key in the `x-api-key` header. Errors use RFC 9457 `application/problem+json`; use the stable `code` field for programmatic handling.",
    "summary": "Build and run pipelines, manage molecular data, and develop custom tools.",
    "title": "Tamarind Public API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pipelines/runs/{runId}": {
      "get": {
        "description": "Query a run for its status overall and per-node, along with output results.",
        "operationId": "getRun",
        "parameters": [
          {
            "in": "path",
            "name": "runId",
            "required": true,
            "schema": {
              "title": "Runid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicRun"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Get a pipeline run",
        "tags": [
          "pipelines-public"
        ],
        "x-doc-group": "Pipelines"
      }
    },
    "/pipelines/runs/{runId}/node-runs/{nodeRunId}/molecules": {
      "get": {
        "description": "The molecules one node run produced, with their scores.\n\nRead a node run's results through this, not through `PublicNodeRun.outputGroup`. `outputGroup` is the group a node MINTED, and two common kinds of node mint none: a node that enriches its inputs in place (scoring, structure prediction) leaves its molecules in the group they came from, and a filter node's survivors exist only as node-run outputs. For both, `outputGroup` is correctly `null` \u2014 reading results by group reports 'produced nothing' for exactly the node runs whose output you asked for. This endpoint answers for every kind of node.\n\n`nodeRunId` is the `id` of an entry in the run's `nodeRuns`.",
        "operationId": "listNodeRunMolecules",
        "parameters": [
          {
            "in": "path",
            "name": "runId",
            "required": true,
            "schema": {
              "title": "Runid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "nodeRunId",
            "required": true,
            "schema": {
              "title": "Noderunid",
              "type": "string"
            }
          },
          {
            "description": "Molecules per page.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "description": "Molecules per page.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Pagination token from the previous response's `nextCursor`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 4096,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pagination token from the previous response's `nextCursor`.",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicNodeRunMoleculePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List the molecules a node run produced",
        "tags": [
          "pipelines-public"
        ],
        "x-doc-group": "Pipelines"
      }
    }
  },
  "servers": [
    {
      "description": "Base URL for the Tamarind public API.",
      "url": "https://app.tamarind.bio/api"
    }
  ]
}
