          },
          "422": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List Tools",
        "tags": [
          "custom-tools-public"
        ],
        "x-doc-group": "Custom Tools"
      },
